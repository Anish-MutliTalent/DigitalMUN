{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "outDir": "./out/renderer",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["../desktop/src/shared/*"]
    },
    "noUnusedLocals": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../desktop/src/shared/**/*.ts"]
}
