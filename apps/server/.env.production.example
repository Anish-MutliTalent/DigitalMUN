# -----------------------------------------------------------------------------
# SAFE MUN 2026 - Production Environment Variables Example
# 
# Instructions:
# On Render (or any cloud host), you do not need this actual file.
# You just need to add these exact Keys and Values into the 
# "Environment Variables" section of the Render dashboard!
# -----------------------------------------------------------------------------

# 1. Enforce Production Mode (Disables local debugging, enables strict security)
NODE_ENV=production

# 2. Database Connection (Supabase Details)
# Replace these with your actual Supabase URI details
# Note: Render does not support IPv6 outbound! You MUST use the "Transaction Pooler" 
# or "Session Pooler" connection from Supabase, which provides an IPv4 address.
PGHOST=aws-0-ap-southeast-1.pooler.supabase.com
PGPORT=6543
PGUSER=postgres.pbpcyayxugvnsgywymst
PGPASSWORD=kpWWU1irzBqbVhjs
PGDATABASE=postgres
PGSSL=true
PG_POOL_MAX=20

# 3. Security Secrets
# Generate a long, random string (e.g., mashing your keyboard) for the session secret.
# This encrypts all the login tokens.
MUN_SESSION_SECRET=wtfffh233427yiV$R%&@$*!T^r43bgf6BF*2nyreuibgry4t6bgerteru

# 4. Admin Credentials
# This is the password you will use to log into the Admin / Chair dashboard.
MUN_BOOTSTRAP_ADMIN_PASSWORD=change-me-immediately-safemun-admin
