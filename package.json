{
  "name": "mun-guardian",
  "version": "1.0.0",
  "private": true,
  "description": "MUN Guardian — committee integrity monitoring for physical Model United Nations conferences.",
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build && pnpm -r --filter=./apps/* build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "pnpm --filter @mun/server migrate",
    "migrate:dev": "pnpm --filter @mun/server migrate:dev",
    "seed": "pnpm --filter @mun/server seed",
    "server:dev": "pnpm --filter @mun/server dev",
    "desktop:dev": "pnpm --filter @mun/desktop dev",
    "desktop:build": "pnpm --filter @mun/desktop build",
    "desktop:pack": "pnpm --filter @mun/desktop pack",
    "loadtest": "pnpm --filter @mun/server loadtest"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "prettier": "^3.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "koffi",
      "@node-rs/argon2"
    ]
  }
}
