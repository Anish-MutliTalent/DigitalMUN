# ─── MUN Guardian server environment ───────────────────────────────────────────
# Copy to .env and adjust. Never commit .env.

# HTTP/WS listen settings
MUN_HOST=0.0.0.0
MUN_PORT=8080

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=mun_guardian
PGSSL=false
PG_POOL_MAX=20

# Session / token signing (32+ byte hex). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MUN_SESSION_SECRET=replace_me_with_a_long_random_hex_string_at_least_32_bytes
MUN_SESSION_TTL_SECONDS=28800
MUN_REFRESH_TTL_SECONDS=2592000

# Access-token TTL (short-lived)
MUN_ACCESS_TTL_SECONDS=900

# Heartbeat / presence
MUN_HEARTBEAT_INTERVAL_MS=5000
MUN_HEARTBEAT_TIMEOUT_MS=16000

# Monitoring ingest rate limiting (per delegate)
MUN_MONITOR_MAX_EVENTS_PER_MINUTE=240

# Audit / voting
MUN_AUDIT_GENESIS=mun-guardian-audit-genesis-v1

# CORS (renderer origin). Use the bundler/app origin for the desktop client.
MUN_CORS_ORIGIN=*

# Default first administrator (created by seed script)
MUN_BOOTSTRAP_ADMIN_USERNAME=admin
MUN_BOOTSTRAP_ADMIN_PASSWORD=change-me-immediately
